#!/usr/bin/env python3
# REPORT-CARD >> features/treemenu.feature
"""Generate a grouped tree of Paketti Renoise menu registrations.

Static by design: this reads Lua source text and resolves literal string menu
names plus simple string concatenations. Dynamic pieces are kept as {name}
placeholders instead of being guessed.
"""

from __future__ import annotations

import argparse
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
import re
from typing import Iterable


CALL_MARKERS = ("PakettiAddMenuEntry", "add_menu_entry")
SKIP_DIRS = {".git", ".codex", ".claude", ".cursor", ".githooks", ".spine", "features"}


@dataclass(frozen=True)
class MenuEntry:
    path: tuple[str, ...]
    raw_name: str
    source: str
    line: int
    call: str
    separator: bool
    dynamic: bool


@dataclass
class TreeNode:
    children: dict[str, "TreeNode"] = field(default_factory=dict)
    entries: list[MenuEntry] = field(default_factory=list)


@dataclass
class LuaStaticContext:
    constants: dict[str, str]
    arrays: dict[str, list[str]]
    records: dict[str, list[dict[str, object]]]


def iter_lua_files(root: Path) -> Iterable[Path]:
    for path in sorted(root.rglob("*.lua")):
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        yield path


def line_number_at(text: str, pos: int) -> int:
    return text.count("\n", 0, pos) + 1


def skip_ws(text: str, i: int) -> int:
    while i < len(text) and text[i].isspace():
        i += 1
    return i


def consume_string(text: str, i: int) -> int:
    quote = text[i]
    i += 1
    while i < len(text):
        ch = text[i]
        if ch == "\\":
            i += 2
        elif ch == quote:
            return i + 1
        else:
            i += 1
    return i


def consume_long_bracket(text: str, i: int) -> int | None:
    if text[i] != "[":
        return None
    j = i + 1
    while j < len(text) and text[j] == "=":
        j += 1
    if j >= len(text) or text[j] != "[":
        return None
    end = "]" + ("=" * (j - i - 1)) + "]"
    k = text.find(end, j + 1)
    return len(text) if k == -1 else k + len(end)


def consume_line_comment(text: str, i: int) -> int:
    j = text.find("\n", i)
    return len(text) if j == -1 else j + 1


def consume_comment(text: str, i: int) -> int:
    # i points at the first '-' of '--'.
    if i + 2 < len(text) and text[i + 2] == "[":
        end = consume_long_bracket(text, i + 2)
        if end is not None:
            return end
    return consume_line_comment(text, i)


def find_calls(text: str) -> Iterable[tuple[int, str]]:
    i = 0
    while i < len(text):
        ch = text[i]
        if ch in ("'", '"'):
            i = consume_string(text, i)
            continue
        if ch == "[":
            end = consume_long_bracket(text, i)
            if end is not None:
                i = end
                continue
        if text.startswith("--", i):
            i = consume_comment(text, i)
            continue

        for marker in CALL_MARKERS:
            if text.startswith(marker, i):
                before = text[i - 1] if i else ""
                after = text[i + len(marker)] if i + len(marker) < len(text) else ""
                if not (before.isalnum() or before == "_") and not (after.isalnum() or after == "_"):
                    yield i, marker
                    i += len(marker)
                    break
        else:
            i += 1


def find_table_start(text: str, i: int) -> int | None:
    i = skip_ws(text, i)
    if i < len(text) and text[i] == "(":
        i = skip_ws(text, i + 1)
    return i if i < len(text) and text[i] == "{" else None


def find_matching_brace(text: str, start: int) -> int | None:
    depth = 0
    i = start
    while i < len(text):
        ch = text[i]
        if ch in ("'", '"'):
            i = consume_string(text, i)
            continue
        if ch == "[":
            end = consume_long_bracket(text, i)
            if end is not None:
                i = end
                continue
        if text.startswith("--", i):
            i = consume_comment(text, i)
            continue
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return None


def find_top_level_name_expr(table_text: str) -> str | None:
    i = 0
    depth = 0
    while i < len(table_text):
        ch = table_text[i]
        if ch in ("'", '"'):
            i = consume_string(table_text, i)
            continue
        if ch == "[":
            end = consume_long_bracket(table_text, i)
            if end is not None:
                i = end
                continue
        if table_text.startswith("--", i):
            i = consume_comment(table_text, i)
            continue
        if ch in "({[":
            depth += 1
            i += 1
            continue
        if ch in ")}]":
            depth = max(0, depth - 1)
            i += 1
            continue
        if depth == 0 and table_text.startswith("name", i):
            before = table_text[i - 1] if i else ""
            after = table_text[i + 4] if i + 4 < len(table_text) else ""
            if not (before.isalnum() or before == "_") and not (after.isalnum() or after == "_"):
                j = skip_ws(table_text, i + 4)
                if j < len(table_text) and table_text[j] == "=":
                    return read_expr_until_top_level_comma(table_text, j + 1)
        i += 1
    return None


def read_expr_until_top_level_comma(text: str, start: int) -> str:
    i = skip_ws(text, start)
    begin = i
    depth = 0
    while i < len(text):
        ch = text[i]
        if ch in ("'", '"'):
            i = consume_string(text, i)
            continue
        if ch == "[":
            end = consume_long_bracket(text, i)
            if end is not None:
                i = end
                continue
        if text.startswith("--", i):
            i = consume_comment(text, i)
            continue
        if ch in "({[":
            depth += 1
        elif ch in ")}]":
            depth = max(0, depth - 1)
        elif ch == "," and depth == 0:
            return text[begin:i].strip()
        i += 1
    return text[begin:].strip()


def collect_string_constants(text: str) -> dict[str, str]:
    constants: dict[str, str] = {}
    assignment = re.compile(
        r"""(?mx)
        ^\s*(?:local\s+)?
        ([A-Za-z_][A-Za-z0-9_]*)\s*=\s*
        (?:
          "((?:\\.|[^"\\])*)"
        | '((?:\\.|[^'\\])*)'
        )
        \s*(?:--.*)?$
        """
    )
    for match in assignment.finditer(text):
        constants[match.group(1)] = decode_lua_escapes(match.group(2) if match.group(2) is not None else match.group(3))
    return constants


def collect_string_arrays(text: str) -> dict[str, list[str]]:
    arrays: dict[str, list[str]] = {}
    assignment = re.compile(r"(?ms)^\s*local\s+([A-Za-z_][A-Za-z0-9_]*)\s*=\s*{(.*?)}")
    for match in assignment.finditer(text):
        body = match.group(2)
        values = []
        for string_match in re.finditer(r'"((?:\\.|[^"\\])*)"|\'((?:\\.|[^\'\\])*)\'', body):
            values.append(decode_lua_escapes(string_match.group(1) if string_match.group(1) is not None else string_match.group(2)))
        if values and not re.search(r"\w+\s*=", body):
            arrays[match.group(1)] = values

    note_names = arrays.get("note_names")
    if note_names and re.search(r"for\s+octave\s*=\s*0\s*,\s*9\s+do.*?table\.insert\(\s*notes\s*,\s*note\s*\.\.\s*octave\s*\)", text, re.S):
        notes = [f"{note}{octave}" for octave in range(10) for note in note_names]
        for extra in re.finditer(r'table\.insert\(\s*notes\s*,\s*["\']((?:\\.|[^"\'])*?)["\']\s*\)', text):
            notes.append(decode_lua_escapes(extra.group(1)))
        arrays["notes"] = notes
    return arrays


def collect_record_tables(text: str) -> dict[str, list[dict[str, object]]]:
    records: dict[str, list[dict[str, object]]] = {}
    for match in re.finditer(r"(?m)^\s*local\s+([A-Za-z_][A-Za-z0-9_]*)\s*=\s*{", text):
        name = match.group(1)
        brace_start = text.find("{", match.start())
        brace_end = find_matching_brace(text, brace_start)
        if brace_end is None:
            continue
        body = text[brace_start + 1:brace_end]
        rows: list[dict[str, object]] = []
        for row in re.finditer(r"{([^{}]*)}", body, re.S):
            record: dict[str, object] = {}
            for field in re.finditer(r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(\"(?:\\.|[^\"\\])*\"|'(?:\\.|[^'\\])*'|-?\d+)", row.group(1)):
                key = field.group(1)
                value = field.group(2).strip()
                decoded = decode_lua_string(value)
                record[key] = decoded if decoded is not None else int(value)
            if record:
                rows.append(record)
        if rows:
            records[name] = rows
    return records


def split_concat(expr: str) -> list[str]:
    parts: list[str] = []
    i = 0
    begin = 0
    depth = 0
    while i < len(expr):
        ch = expr[i]
        if ch in ("'", '"'):
            i = consume_string(expr, i)
            continue
        if ch == "[":
            end = consume_long_bracket(expr, i)
            if end is not None:
                i = end
                continue
        if ch in "({[":
            depth += 1
        elif ch in ")}]":
            depth = max(0, depth - 1)
        elif depth == 0 and expr.startswith("..", i):
            parts.append(expr[begin:i].strip())
            i += 2
            begin = i
            continue
        i += 1
    parts.append(expr[begin:].strip())
    return parts


def decode_lua_escapes(value: str) -> str:
    out: list[str] = []
    i = 0
    escapes = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", '"': '"', "'": "'"}
    while i < len(value):
        if value[i] == "\\" and i + 1 < len(value):
            out.append(escapes.get(value[i + 1], value[i + 1]))
            i += 2
        else:
            out.append(value[i])
            i += 1
    return "".join(out)


def decode_lua_string(part: str) -> str | None:
    part = part.strip()
    if len(part) >= 2 and part[0] in ("'", '"') and part[-1] == part[0]:
        return decode_lua_escapes(part[1:-1])
    if part.startswith("["):
        end = consume_long_bracket(part, 0)
        if end == len(part):
            open_end = part.find("[", 1)
            close_start = part.rfind("]")
            return part[open_end + 1:close_start]
    return None


def resolve_name_expr(expr: str, constants: dict[str, str]) -> tuple[str | None, bool]:
    parts = split_concat(expr)
    resolved: list[str] = []
    dynamic = False
    for part in parts:
        if not part:
            continue
        string = decode_lua_string(part)
        if string is not None:
            resolved.append(string)
            continue
        if part in constants:
            resolved.append(constants[part])
            continue
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*", part):
            resolved.append("{" + part + "}")
            dynamic = True
            continue
        return None, True
    return "".join(resolved), dynamic


def split_args(expr: str) -> list[str]:
    args: list[str] = []
    i = 0
    begin = 0
    depth = 0
    while i < len(expr):
        ch = expr[i]
        if ch in ("'", '"'):
            i = consume_string(expr, i)
            continue
        if ch in "({[":
            depth += 1
        elif ch in ")}]":
            depth = max(0, depth - 1)
        elif ch == "," and depth == 0:
            args.append(expr[begin:i].strip())
            begin = i + 1
        i += 1
    tail = expr[begin:].strip()
    if tail:
        args.append(tail)
    return args


def lua_format(fmt: str, values: list[object]) -> str:
    converted = fmt.replace("%%", "\u0000")
    for value in values:
        match = re.search(r"%0?(\d*)d|%s", converted)
        if not match:
            break
        token = match.group(0)
        if token.endswith("d"):
            width = int(match.group(1) or 0)
            replacement = f"{int(value):0{width}d}" if width else str(int(value))
        else:
            replacement = str(value)
        converted = converted[:match.start()] + replacement + converted[match.end():]
    return converted.replace("\u0000", "%")


def eval_simple_expr(expr: str, env: dict[str, object], context: LuaStaticContext) -> object | None:
    expr = expr.strip()
    string = decode_lua_string(expr)
    if string is not None:
        return string
    if re.fullmatch(r"-?\d+", expr):
        return int(expr)
    if expr in env:
        return env[expr]
    if expr in context.constants:
        return context.constants[expr]

    field_match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)", expr)
    if field_match:
        table = env.get(field_match.group(1))
        if isinstance(table, dict):
            return table.get(field_match.group(2))

    index_match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)\[([A-Za-z_][A-Za-z0-9_]*|-?\d+)\]", expr)
    if index_match:
        array = context.arrays.get(index_match.group(1))
        if array:
            raw_index = eval_simple_expr(index_match.group(2), env, context)
            if isinstance(raw_index, int) and 1 <= raw_index <= len(array):
                return array[raw_index - 1]
    return None


def eval_name_expr(expr: str, env: dict[str, object], context: LuaStaticContext) -> str | None:
    expr = expr.strip()
    format_match = re.fullmatch(r"string\.format\((.*)\)", expr, re.S)
    if format_match:
        args = split_args(format_match.group(1))
        if not args:
            return None
        fmt = eval_simple_expr(args[0], env, context)
        if not isinstance(fmt, str):
            return None
        values = [eval_simple_expr(arg, env, context) for arg in args[1:]]
        if any(value is None for value in values):
            return None
        return lua_format(fmt, values)

    parts = split_concat(expr)
    rendered: list[str] = []
    for part in parts:
        value = eval_simple_expr(part, env, context)
        if value is None:
            return None
        rendered.append(str(value))
    return "".join(rendered)


def lua_block_end(text: str, start: int) -> int:
    depth = 1
    token_re = re.compile(r"\b(for|function|if|end)\b")
    for match in token_re.finditer(text, start):
        token = match.group(1)
        if token in {"for", "function", "if"}:
            depth += 1
        elif token == "end":
            depth -= 1
            if depth == 0:
                return match.end()
    return len(text)


def loop_encloses(text: str, match: re.Match[str], pos: int) -> bool:
    return match.start() < pos < lua_block_end(text, match.end())


def numeric_loop_values(var: str, text: str, pos: int, env: dict[str, object], context: LuaStaticContext) -> list[int] | None:
    pattern = re.compile(rf"for\s+{re.escape(var)}\s*=\s*([^,]+)\s*,\s*([^\s]+)\s+do")
    matches = [match for match in pattern.finditer(text, 0, pos) if loop_encloses(text, match, pos)]
    if not matches:
        return None
    match = matches[-1]
    start = eval_simple_expr(match.group(1), env, context)
    end = eval_simple_expr(match.group(2), env, context)
    if isinstance(start, int) and isinstance(end, int):
        return list(range(start, end + 1))
    return None


def table_loop_records(var: str, text: str, pos: int, context: LuaStaticContext) -> list[dict[str, object]] | None:
    pattern = re.compile(rf"for\s+[^,\n]+,\s*{re.escape(var)}\s+in\s+ipairs\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s+do")
    matches = [match for match in pattern.finditer(text, 0, pos) if loop_encloses(text, match, pos)]
    if not matches:
        return None
    table_name = matches[-1].group(1)
    return context.records.get(table_name)


def table_loop_values(var: str, text: str, pos: int, context: LuaStaticContext) -> list[str] | None:
    inline = re.compile(rf"for\s+[^,\n]+,\s*{re.escape(var)}\s+in\s+ipairs\(\s*{{(.*?)}}\s*\)\s+do", re.S)
    inline_matches = [match for match in inline.finditer(text, 0, pos) if loop_encloses(text, match, pos)]
    if inline_matches:
        values = []
        for string_match in re.finditer(r'"((?:\\.|[^"\\])*)"|\'((?:\\.|[^\'\\])*)\'', inline_matches[-1].group(1)):
            values.append(decode_lua_escapes(string_match.group(1) if string_match.group(1) is not None else string_match.group(2)))
        if values:
            return values

    named = re.compile(rf"for\s+[^,\n]+,\s*{re.escape(var)}\s+in\s+ipairs\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s+do")
    named_matches = [match for match in named.finditer(text, 0, pos) if loop_encloses(text, match, pos)]
    if named_matches:
        return context.arrays.get(named_matches[-1].group(1))
    return None


def expand_name_expr(expr: str, text: str, pos: int, context: LuaStaticContext) -> list[str]:
    envs: list[dict[str, object]] = [{}]

    for var in sorted(set(re.findall(r"\b([A-Za-z_][A-Za-z0-9_]*)\.", expr))):
        records = table_loop_records(var, text, pos, context)
        if records:
            envs = [{**env, var: record} for env in envs for record in records]

    for var in sorted(set(re.findall(r"\b([A-Za-z_][A-Za-z0-9_]*)\b", expr))):
        if var in {"string", "format"}:
            continue
        expanded_envs: list[dict[str, object]] = []
        changed = False
        for env in envs:
            if var in env:
                expanded_envs.append(env)
                continue
            loop_values = table_loop_values(var, text, pos, context)
            if loop_values:
                expanded_envs.extend({**env, var: value} for value in loop_values)
                changed = True
                continue
            values = numeric_loop_values(var, text, pos, env, context)
            if values:
                expanded_envs.extend({**env, var: value} for value in values)
                changed = True
            else:
                expanded_envs.append(env)
        envs = expanded_envs
        if changed and len(envs) > 500:
            break

    expanded: list[str] = []
    for env in envs:
        value = eval_name_expr(expr, env, context)
        if value is not None:
            expanded.append(value)
    return list(dict.fromkeys(expanded))


def clean_menu_path(raw_name: str) -> tuple[tuple[str, ...], bool]:
    if raw_name.startswith("{unresolved:"):
        return (raw_name,), False
    separator = raw_name.startswith("--")
    name = raw_name[2:] if separator else raw_name
    parts = tuple(part.strip() for part in name.split(":") if part.strip())
    return parts, separator


def extract_entries(path: Path, root: Path) -> list[MenuEntry]:
    text = path.read_text(encoding="utf-8", errors="replace")
    context = LuaStaticContext(
        constants=collect_string_constants(text),
        arrays=collect_string_arrays(text),
        records=collect_record_tables(text),
    )
    entries: list[MenuEntry] = []
    rel = str(path.relative_to(root))
    for pos, marker in find_calls(text):
        table_start = find_table_start(text, pos + len(marker))
        if table_start is None:
            continue
        table_end = find_matching_brace(text, table_start)
        if table_end is None:
            continue
        table_text = text[table_start + 1:table_end]
        expr = find_top_level_name_expr(table_text)
        if not expr:
            continue
        raw_name, dynamic = resolve_name_expr(expr, context.constants)
        raw_names = [raw_name] if raw_name is not None else []
        if raw_name is None or dynamic:
            expanded = expand_name_expr(expr, text, pos, context)
            if expanded:
                raw_names = expanded
                dynamic = False
        if not raw_names:
            raw_names = ["{unresolved: " + " ".join(expr.split()) + "}"]
            dynamic = True
        for raw_menu_name in raw_names:
            menu_path, separator = clean_menu_path(raw_menu_name)
            if not menu_path:
                continue
            entries.append(
                MenuEntry(
                    path=menu_path,
                    raw_name=raw_menu_name,
                    source=rel,
                    line=line_number_at(text, pos),
                    call=marker,
                    separator=separator,
                    dynamic=dynamic or "{" in raw_menu_name,
                )
            )
    return entries


def tree_insert(root: TreeNode, entry: MenuEntry) -> None:
    node = root
    for part in entry.path[:-1]:
        node = node.children.setdefault(part, TreeNode())
    node.children.setdefault(entry.path[-1], TreeNode()).entries.append(entry)


def sort_key(text: str) -> str:
    return text.replace("!", "").casefold()


def menu_path(path: tuple[str, ...]) -> str:
    return ":".join(path)


def tree_prefix(depth: int) -> str:
    if depth <= 0:
        return ""
    return "| " * (depth - 1) + "|____"


def format_tree(node: TreeNode, depth: int = 0, ancestors: tuple[str, ...] = ()) -> list[str]:
    lines: list[str] = []
    for name in sorted(node.children, key=sort_key):
        child = node.children[name]
        path = ancestors + (name,)
        full_path = menu_path(path)
        entries = sorted(child.entries, key=lambda e: (e.source.casefold(), e.line, e.call))
        prefix = tree_prefix(depth)
        if entries and not child.children:
            first, *rest = entries
            lines.append(f"{prefix}{full_path} - {source_line(first)}")
            for entry in rest:
                lines.append(f"{prefix}{full_path} - {source_line(entry)}")
        else:
            lines.append(f"{prefix}{name}")
            for entry in entries:
                lines.append(f"{tree_prefix(depth + 1)}{full_path} - {source_line(entry)}")
        lines.extend(format_tree(child, depth + 1, path))
    return lines


def format_flat(entries: list[MenuEntry]) -> list[str]:
    lines = []
    for entry in sorted(entries, key=lambda e: (tuple(sort_key(p) for p in e.path), e.source.casefold(), e.line)):
        path = menu_path(entry.path)
        tags = []
        if entry.separator:
            tags.append("separator")
        if entry.dynamic:
            tags.append("dynamic")
        tag_text = f" [{' '.join(tags)}]" if tags else ""
        lines.append(f"{path} :: {entry.source}:{entry.line} ({entry.call}){tag_text}")
    return lines


def entry_tags(entry: MenuEntry) -> str:
    tags = []
    if entry.separator:
        tags.append("separator")
    if entry.dynamic:
        tags.append("dynamic")
    return f" [{' '.join(tags)}]" if tags else ""


def source_line(entry: MenuEntry) -> str:
    return f"{entry.source}:{entry.line} ({entry.call}){entry_tags(entry)}"


def format_entry_list(entries: list[MenuEntry]) -> list[str]:
    lines = []
    for entry in sorted(entries, key=lambda e: (e.source.casefold(), e.line, tuple(sort_key(p) for p in e.path))):
        lines.append(f"- {menu_path(entry.path)}")
        lines.append(f"  source: {source_line(entry)}")
    return lines


def format_duplicates(entries: list[MenuEntry]) -> list[str]:
    by_path: dict[tuple[str, ...], list[MenuEntry]] = {}
    for entry in entries:
        by_path.setdefault(entry.path, []).append(entry)
    duplicate_paths = [(path, hits) for path, hits in by_path.items() if len(hits) > 1]
    duplicate_paths.sort(key=lambda item: (-len(item[1]), tuple(sort_key(p) for p in item[0])))

    lines = []
    for path, hits in duplicate_paths:
        lines.append(f"- {menu_path(path)} ({len(hits)} registrations)")
        for hit in sorted(hits, key=lambda e: (e.source.casefold(), e.line)):
            lines.append(f"  - {source_line(hit)}")
    return lines


def build_report(root: Path, entries: list[MenuEntry], branch: str | None = None) -> str:
    if branch:
        entries = [entry for entry in entries if entry.path and entry.path[0] == branch]

    static_entries = [entry for entry in entries if not entry.dynamic]
    dynamic_entries = [entry for entry in entries if entry.dynamic]

    tree = TreeNode()
    for entry in static_entries:
        tree_insert(tree, entry)

    dynamic_count = sum(1 for entry in entries if entry.dynamic)
    separator_count = sum(1 for entry in entries if entry.separator)
    root_counts = Counter(entry.path[0] for entry in static_entries)
    dynamic_known_root_counts = Counter(entry.path[0] for entry in dynamic_entries if entry.path[0] in root_counts)
    dynamic_unknown_root_count = sum(1 for entry in dynamic_entries if entry.path[0] not in root_counts)
    static_by_file = Counter(entry.source for entry in static_entries)

    lines = [
        "Paketti Menu Tree",
        "=================",
        "",
        f"Source root: {root}",
        f"Branch filter: {branch}" if branch else "Branch filter: all",
        f"Menu registrations found: {len(entries)}",
        f"Static exact paths in tree: {len(static_entries)}",
        f"Dynamic/partial paths listed separately: {dynamic_count}",
        f"Leading separator entries: {separator_count}",
        "",
        "Static root branches:",
    ]
    for name, count in sorted(root_counts.items(), key=lambda item: sort_key(item[0])):
        lines.append(f"- {name} ({count})")
    lines.extend(["", "Top files by static registrations:"])
    for source, count in static_by_file.most_common(20):
        lines.append(f"- {source} ({count})")
    if dynamic_entries:
        lines.extend(["", "Dynamic/partial roots kept out of the exact tree:"])
        for name, count in sorted(dynamic_known_root_counts.items(), key=lambda item: sort_key(item[0])):
            lines.append(f"- {name} ({count})")
        if dynamic_unknown_root_count:
            lines.append(f"- Unknown/dynamic root ({dynamic_unknown_root_count})")

    lines.extend(["", "Exact Static Tree:", ""])
    lines.extend(format_tree(tree))

    duplicate_lines = format_duplicates(static_entries)
    lines.extend(["", "Duplicate exact menu paths:", ""])
    if duplicate_lines:
        lines.extend(duplicate_lines)
    else:
        lines.append("- None")

    lines.extend(["", "Dynamic / partial registrations:", ""])
    if dynamic_entries:
        lines.extend(format_entry_list(dynamic_entries))
    else:
        lines.append("- None")

    lines.extend(["", "Notes:", ""])
    lines.append("- Leading Renoise separator marker `--` is stripped for grouping and shown as `[separator]` on the source line.")
    lines.append("- The Exact Static Tree contains only paths whose menu text is fully known from source.")
    lines.append("- Dynamic pieces that cannot be known statically are shown as `{identifier}` or `{unresolved: ...}` in the separate dynamic section.")
    lines.append("- Commented-out menu registrations are skipped.")
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate menu_items.txt from Paketti Lua menu registrations.")
    parser.add_argument("--root", default=".", help="Repo root to scan")
    parser.add_argument("--output", default="menu_items.txt", help="Output text file")
    parser.add_argument("--branch", help='Only include one root branch, for example "Sample Editor"')
    args = parser.parse_args()

    root = Path(args.root).resolve()
    entries: list[MenuEntry] = []
    for lua_file in iter_lua_files(root):
        entries.extend(extract_entries(lua_file, root))
    entries.sort(key=lambda e: (tuple(sort_key(p) for p in e.path), e.source.casefold(), e.line))

    output = root / args.output
    output.write_text(build_report(root, entries, args.branch), encoding="utf-8")
    static_count = sum(1 for entry in entries if not entry.dynamic)
    dynamic_count = len(entries) - static_count
    report_entries = [entry for entry in entries if not args.branch or entry.path[0] == args.branch]
    roots = Counter(entry.path[0] for entry in report_entries if not entry.dynamic)
    print(f"Wrote {output}")
    if args.branch:
        print(f"  branch: {args.branch}")
    print(f"  registrations scanned: {len(entries)}")
    print(f"  registrations in report: {len(report_entries)}")
    print(f"  exact static paths scanned: {static_count}")
    print(f"  dynamic/partial paths scanned: {dynamic_count}")
    print("  root branches: " + ", ".join(f"{name} ({count})" for name, count in sorted(roots.items(), key=lambda item: sort_key(item[0]))))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
